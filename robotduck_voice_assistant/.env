DASHSCOPE_API_KEY=xxxx

# OpenAI兼容接口（一般不用改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ASR websocket（北京）
DASHSCOPE_WS_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 模型（一般不用改）
ROUTER_MODEL=qwen-turbo
TEXT_MODEL=qwen-turbo
VISION_MODEL=qwen-vl-max

# TTS（一般不用改）
TTS_MODEL=cosyvoice-v3-flash
DEFAULT_VOICE=longanhuan

# 音频
AUDIO_SAMPLE_RATE=16000

# 摄像头序号
CAMERA_INDEX=0

# ====== 下面 OSS 是可选（克隆/视觉需要） ======
OSS_ACCESS_KEY_ID=xxxx
OSS_ACCESS_KEY_SECRET=xxxx
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=xxxx
OSS_PUBLIC_BASE=https://fancy.oss-cn-shanghai.aliyuncs.com
